rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Only verified site owner or custom-claim admin
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             (
               request.auth.token.admin == true ||
               request.auth.token.email == 'andart1174@gmail.com'
             );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Protected entitlement fields — ONLY server-side Admin SDK / Admin may modify!
    function touchesProtectedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isPremium',
        'premiumUntil',
        'hasExportCredit',
        'stripeSessionId',
        'stripeSubscriptionId',
        'stripeCustomerId',
        'subscriptionStatus',
        'planType',
        'banned',
        'role',
        'admin',
        'preRegistered'
      ]);
    }

    // 1. USERS COLLECTION (Zero client self-upgrade!)
    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();

      // New user profile creation: ALWAYS starts non-premium with zero credits.
      // Premium upgrades & VIP migrations run exclusively server-side via Admin SDK!
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.isPremium == false &&
        (!('premiumUntil' in request.resource.data) || request.resource.data.premiumUntil == null) &&
        (!('hasExportCredit' in request.resource.data) || request.resource.data.hasExportCredit == false) &&
        (!('banned' in request.resource.data) || request.resource.data.banned == false) &&
        !('stripeSessionId' in request.resource.data) &&
        !('stripeSubscriptionId' in request.resource.data) &&
        !('stripeCustomerId' in request.resource.data) &&
        !('role' in request.resource.data) &&
        !('admin' in request.resource.data)
      );

      // Regular users may ONLY increment freeExportsUsed or update non-privileged fields.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !touchesProtectedUserFields() &&
        (
          !('freeExportsUsed' in request.resource.data) ||
          !('freeExportsUsed' in resource.data) ||
          (
            request.resource.data.freeExportsUsed is int &&
            request.resource.data.freeExportsUsed >= resource.data.freeExportsUsed
          )
        )
      );

      allow delete: if isAdmin();
    }

    // 2. CONTACT MESSAGES (Strict field allowlist & length caps)
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'timestamp', 'read', 'lang']) &&
                       request.resource.data.keys().hasAll(['name', 'email', 'message', 'timestamp']) &&
                       request.resource.data.name is string &&
                       request.resource.data.name.size() >= 1 &&
                       request.resource.data.name.size() <= 120 &&
                       request.resource.data.email is string &&
                       request.resource.data.email.size() >= 3 &&
                       request.resource.data.email.size() <= 254 &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() >= 1 &&
                       request.resource.data.message.size() <= 5000 &&
                       (!('read' in request.resource.data) || request.resource.data.read == false);
      allow read, update, delete: if isAdmin();
    }

    // 3. SYSTEM ANNOUNCEMENTS (Public read, Admin-only write)
    match /announcements/{annId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. SITE CONFIG / MAINTENANCE BANNER (Public read, Admin-only write)
    match /site_config/{cfgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. NEWSLETTER SUBSCRIPTIONS (Strict field allowlist, Admin-only read/delete)
    match /newsletter/{subId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'timestamp', 'lang', 'source']) &&
                       request.resource.data.email is string &&
                       request.resource.data.email.size() >= 5 &&
                       request.resource.data.email.size() <= 254;
      allow read, update, delete: if isAdmin();
    }

    // 6. LIVE COLLABORATION ROOMS (Authenticated only + strict schema & size caps)
    match /scripting_rooms/{roomId}/messages/{msgId} {
      allow read: if request.auth != null && roomId.matches('^[a-zA-Z0-9_-]{4,32}$');
      allow create: if request.auth != null &&
                       roomId.matches('^[a-zA-Z0-9_-]{4,32}$') &&
                       request.resource.data.keys().hasOnly(['userId', 'type', 'code', 'text', 'timestamp', 'uid']) &&
                       request.resource.data.type is string &&
                       request.resource.data.type in ['CODE_SYNC', 'CHAT'] &&
                       (!('code' in request.resource.data) || (request.resource.data.code is string && request.resource.data.code.size() <= 40000)) &&
                       (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 1000));
      allow update, delete: if isAdmin();
    }

    // 7. SERVER-ONLY REDEEMED STRIPE SESSIONS (Admin SDK bypasses rules)
    match /redeemed_sessions/{sessionId} {
      allow read, write: if false;
    }

    // 8. ADMIN AUDIT LOGS & SEO INDEXING LOGS (Admin read only, server writes)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /seo_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
